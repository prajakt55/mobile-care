<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mobile Care | Mobile Repair & Accessories Shop in Gadhinglaj</title>
    <meta name="description" content="Fast & reliable smartphone repair shop on Bhadgaon Road, Gadhinglaj. Screen replacement, battery repair, charging port fix, software solutions, and original mobile accessories.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --white: #FFFFFF;
            --off-white: #F8FAFC;
            --charcoal: #1A1A2E;
            --charcoal-light: #252542;
            --electric-blue: #2563EB;
            --electric-blue-hover: #1D4ED8;
            --cyan: #06B6D4;
            --cyan-light: #E0F2FE;
            --gray-subtle: #E2E8F0;
            --text-dark: #0F172A;
            --text-muted: #64748B;
            
            --font-heading: 'Space Grotesk', sans-serif;
            --font-body: 'Inter', sans-serif;

            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(0, 0, 0, 0.04);
            --shadow-lg: 0 20px 25px -5px rgba(37, 99, 235, 0.12), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            --radius-card: 16px;
            --radius-btn: 50px;
            --transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
            font-size: 16px;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--white);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-heading);
            color: var(--charcoal);
            line-height: 1.25;
            font-weight: 700;
        }

        a {
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
        }

        ul {
            list-style: none;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        .container {
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.85rem 1.75rem;
            font-family: var(--font-body);
            font-weight: 600;
            font-size: 0.95rem;
            border-radius: var(--radius-btn);
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid transparent;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--electric-blue);
            color: var(--white);
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }

        .btn-primary:hover {
            background-color: var(--electric-blue-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        }

        .btn-cyan {
            background-color: var(--cyan);
            color: var(--white);
            box-shadow: 0 4px 14px rgba(6, 182, 212, 0.35);
        }

        .btn-cyan:hover {
            background-color: #0891B2;
            transform: translateY(-2px);
        }

        .btn-outline {
            background-color: transparent;
            border-color: rgba(255, 255, 255, 0.4);
            color: var(--white);
        }

        .btn-outline:hover {
            background-color: var(--white);
            color: var(--charcoal);
            border-color: var(--white);
            transform: translateY(-2px);
        }

        .section-header {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 3.5rem auto;
        }

        .section-tag {
            display: inline-block;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--electric-blue);
            font-weight: 700;
            background-color: rgba(37, 99, 235, 0.08);
            padding: 0.4rem 1rem;
            border-radius: 50px;
            margin-bottom: 0.85rem;
        }

        .section-title {
            font-size: clamp(2rem, 4vw, 2.75rem);
            margin-bottom: 1rem;
        }

        .section-subtitle {
            font-size: 1.05rem;
            color: var(--text-muted);
            font-weight: 400;
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .announcement-bar {
            background-color: var(--charcoal);
            color: var(--white);
            text-align: center;
            padding: 0.6rem 1rem;
            font-size: 0.88rem;
            font-weight: 500;
            letter-spacing: 0.3px;
            position: relative;
            z-index: 1002;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .announcement-bar span {
            color: var(--cyan);
            font-weight: 700;
        }

        .header {
            position: sticky;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background-color: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-subtle);
            transition: var(--transition);
        }

        .header.scrolled {
            box-shadow: var(--shadow-sm);
            background-color: rgba(255, 255, 255, 0.98);
        }

        .nav-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            height: 76px;
        }

        .logo {
            font-family: var(--font-heading);
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--charcoal);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .logo-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--electric-blue), var(--cyan));
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--white);
            font-size: 1.2rem;
            box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
        }

        .logo span {
            color: var(--electric-blue);
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .nav-link {
            font-size: 0.95rem;
            font-weight: 500;
            color: var(--text-dark);
            position: relative;
            padding: 0.25rem 0;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--electric-blue);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after, .nav-link.active::after {
            width: 100%;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .hamburger {
            display: none;
            cursor: pointer;
            background: none;
            border: none;
            width: 28px;
            height: 22px;
            position: relative;
            z-index: 1002;
        }

        .hamburger span {
            display: block;
            width: 100%;
            height: 2.5px;
            background-color: var(--charcoal);
            position: absolute;
            transition: var(--transition);
            border-radius: 2px;
        }

        .hamburger span:nth-child(1) { top: 0; }
        .hamburger span:nth-child(2) { top: 9px; }
        .hamburger span:nth-child(3) { top: 18px; }

        .hamburger.active span:nth-child(1) {
            transform: rotate(45deg);
            top: 9px;
        }
        .hamburger.active span:nth-child(2) {
            opacity: 0;
        }
        .hamburger.active span:nth-child(3) {
            transform: rotate(-45deg);
            top: 9px;
        }

        .mobile-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: rgba(15, 23, 42, 0.5);
            backdrop-filter: blur(4px);
            z-index: 999;
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }

        .mobile-overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .hero {
            position: relative;
            min-height: 88vh;
            display: flex;
            align-items: center;
            background-image: linear-gradient(135deg, rgba(26, 26, 46, 0.9) 0%, rgba(37, 99, 235, 0.78) 100%), url('https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1920&q=80');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            color: var(--white);
            padding: 5rem 0;
        }

        @media (max-width: 1024px) {
            .hero {
                background-attachment: scroll;
            }
        }

        .hero-content {
            max-width: 720px;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            padding: 0.5rem 1.25rem;
            border-radius: var(--radius-btn);
            font-size: 0.88rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        .hero-title {
            font-size: clamp(2.5rem, 5.5vw, 4.2rem);
            margin-bottom: 1.25rem;
            color: var(--white);
            line-height: 1.15;
        }

        .hero-subtitle {
            font-size: clamp(1.05rem, 2vw, 1.25rem);
            margin-bottom: 2.5rem;
            color: rgba(255, 255, 255, 0.9);
            font-weight: 300;
            line-height: 1.6;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .trust-bar {
            background-color: var(--off-white);
            border-top: 1px solid var(--gray-subtle);
            border-bottom: 1px solid var(--gray-subtle);
            padding: 1.75rem 0;
        }

        .trust-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.5rem;
            align-items: center;
        }

        .trust-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            font-weight: 600;
            font-size: 0.95rem;
            color: var(--charcoal);
        }

        .trust-icon {
            width: 36px;
            height: 36px;
            background-color: var(--white);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--cyan);
            box-shadow: var(--shadow-sm);
            font-size: 1.1rem;
            border: 1px solid var(--gray-subtle);
        }

        .services {
            padding: 6.5rem 0;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }

        .service-card {
            background-color: var(--white);
            border-radius: var(--radius-card);
            padding: 2.25rem;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-subtle);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(37, 99, 235, 0.3);
        }

        .service-icon-wrap {
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, rgba(37, 99, 235, 0.1), rgba(6, 182, 212, 0.15));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            color: var(--electric-blue);
            margin-bottom: 1.5rem;
        }

        .service-title {
            font-size: 1.35rem;
            margin-bottom: 0.75rem;
        }

        .service-desc {
            font-size: 0.95rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            line-height: 1.6;
        }

        .service-link {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-weight: 600;
            font-size: 0.92rem;
            color: var(--electric-blue);
        }

        .service-card:hover .service-link {
            gap: 0.75rem;
            color: var(--electric-blue-hover);
        }

        .accessories {
            padding: 6.5rem 0;
            background-color: var(--off-white);
            border-top: 1px solid var(--gray-subtle);
            border-bottom: 1px solid var(--gray-subtle);
        }

        .accessories-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .accessory-card {
            background-color: var(--white);
            border-radius: var(--radius-card);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-subtle);
            transition: var(--transition);
            display: flex;
            flex-direction: column;
        }

        .accessory-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

        .accessory-img {
            width: 100%;
            height: 230px;
            overflow: hidden;
            position: relative;
            background-color: var(--off-white);
        }

        .accessory-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .accessory-card:hover .accessory-img img {
            transform: scale(1.06);
        }

        .accessory-tag {
            position: absolute;
            top: 1rem;
            left: 1rem;
            background-color: var(--charcoal);
            color: var(--white);
            padding: 0.35rem 0.85rem;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .accessory-info {
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            flex: 1;
            justify-content: space-between;
        }

        .accessory-name {
            font-size: 1.2rem;
            margin-bottom: 0.4rem;
        }

        .accessory-desc {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
        }

        .accessory-action {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-top: 1rem;
            border-top: 1px solid var(--gray-subtle);
        }

        .accessory-badge {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--cyan);
        }

        .how-it-works {
            padding: 6.5rem 0;
        }

        .steps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2.5rem;
        }

        .step-card {
            background-color: var(--white);
            padding: 2.5rem 2rem;
            border-radius: var(--radius-card);
            border: 1px solid var(--gray-subtle);
            box-shadow: var(--shadow-sm);
            text-align: center;
            transition: var(--transition);
        }

        .step-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-md);
        }

        .step-number {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, var(--electric-blue), var(--cyan));
            color: var(--white);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 1.25rem;
            margin: 0 auto 1.5rem auto;
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .step-title {
            font-size: 1.3rem;
            margin-bottom: 0.75rem;
        }

        .step-desc {
            font-size: 0.95rem;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .reviews {
            padding: 6.5rem 0;
            background-color: var(--off-white);
            border-top: 1px solid var(--gray-subtle);
            border-bottom: 1px solid var(--gray-subtle);
        }

        .reviews-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
            gap: 2rem;
        }

        .review-card {
            background-color: var(--white);
            padding: 2.25rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-subtle);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .review-stars {
            color: #F59E0B;
            font-size: 1.1rem;
            margin-bottom: 1rem;
            letter-spacing: 2px;
        }

        .review-quote {
            font-size: 0.98rem;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            line-height: 1.65;
            font-style: italic;
        }

        .review-author {
            display: flex;
            align-items: center;
            gap: 1rem;
            border-top: 1px solid var(--gray-subtle);
            padding-top: 1.25rem;
        }

        .author-avatar {
            width: 44px;
            height: 44px;
            background-color: var(--cyan-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--electric-blue);
        }

        .author-info h5 {
            font-size: 0.98rem;
            margin-bottom: 0.1rem;
        }

        .author-info p {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        .visit {
            padding: 7rem 0;
        }

        .visit-grid {
            display: grid;
            grid-template-columns: 1fr 1.2fr;
            gap: 3.5rem;
            align-items: stretch;
        }

        @media (max-width: 992px) {
            .visit-grid {
                grid-template-columns: 1fr;
            }
        }

        .visit-info-card {
            background-color: var(--white);
            padding: 2.75rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-subtle);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .visit-detail-item {
            display: flex;
            align-items: flex-start;
            gap: 1.2rem;
            margin-bottom: 1.75rem;
        }

        .visit-detail-item .icon-box {
            width: 46px;
            height: 46px;
            background-color: rgba(37, 99, 235, 0.1);
            color: var(--electric-blue);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .visit-detail-item h5 {
            font-size: 0.88rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 0.2rem;
        }

        .visit-detail-item p {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .map-container {
            width: 100%;
            min-height: 420px;
            border-radius: var(--radius-card);
            overflow: hidden;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--gray-subtle);
        }

        .map-container iframe {
            width: 100%;
            height: 100%;
            min-height: 420px;
            border: 0;
        }

        .quote {
            padding: 6.5rem 0;
            background-color: var(--off-white);
            border-top: 1px solid var(--gray-subtle);
        }

        .quote-wrapper {
            max-width: 720px;
            margin: 0 auto;
            background-color: var(--white);
            padding: 3.5rem;
            border-radius: var(--radius-card);
            box-shadow: var(--shadow-md);
            border: 1px solid var(--gray-subtle);
        }

        @media (max-width: 576px) {
            .quote-wrapper {
                padding: 2rem;
            }
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-label {
            display: block;
            font-weight: 600;
            font-size: 0.92rem;
            margin-bottom: 0.5rem;
            color: var(--text-dark);
        }

        .form-control {
            width: 100%;
            padding: 0.85rem 1.1rem;
            font-family: var(--font-body);
            font-size: 0.98rem;
            border: 1px solid var(--gray-subtle);
            border-radius: 10px;
            background-color: var(--off-white);
            color: var(--text-dark);
            transition: var(--transition);
        }

        .form-control:focus {
            outline: none;
            border-color: var(--electric-blue);
            background-color: var(--white);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
        }

        textarea.form-control {
            resize: vertical;
            min-height: 120px;
        }

        .form-submit-btn {
            width: 100%;
            padding: 1rem;
            font-size: 1rem;
            font-weight: 600;
            border-radius: var(--radius-btn);
            background-color: var(--electric-blue);
            color: var(--white);
            border: none;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        }

        .form-submit-btn:hover {
            background-color: var(--electric-blue-hover);
            box-shadow: 0 6px 20px rgba(37, 99, 235, 0.45);
        }

        .form-success-msg {
            display: none;
            background-color: #ECFDF5;
            color: #047857;
            padding: 1rem;
            border-radius: 10px;
            text-align: center;
            font-weight: 600;
            margin-top: 1.25rem;
            border: 1px solid #A7F3D0;
        }

        .footer {
            background-color: var(--charcoal);
            color: var(--white);
            padding: 5rem 0 2rem 0;
        }

        .footer-grid {
            display: grid;
